<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Runs after DBH_Research.xml, which sets the stall door's research -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Progression: Furniture</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="ToiletStallDoor"]/researchPrerequisites</xpath>
      <value>
        <li>Ferny_Door</li>
      </value>
    </match>
  </Operation>
</Patch>
